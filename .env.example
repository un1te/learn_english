# Supabase (отримати в Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — тільки для серверних операцій (забування слів тощо)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pixabay API key (безкоштовний, https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your-pixabay-key

# Внутрішній домен для псевдо-email (вхід тільки за імʼям)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=app.local
